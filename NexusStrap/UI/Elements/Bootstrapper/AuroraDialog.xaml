<base:WpfUiWindow
    xmlns:base="clr-namespace:NexusStrap.UI.Elements.Base"
    x:Class="NexusStrap.UI.Elements.Bootstrapper.AuroraDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="640"
    Height="400"
    MinHeight="0"
    Background="#FF0A0A14"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Disable"
    Closing="UiWindow_Closing"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <base:WpfUiWindow.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </base:WpfUiWindow.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Aurora background glows -->
        <Ellipse Grid.RowSpan="3" Width="620" Height="260" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-150,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4D7C4DFF" Offset="0" />
                    <GradientStop Color="#3300FFAA" Offset="0.45" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.RowSpan="3" Width="500" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-120" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4D00C2FF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.RowSpan="3" Width="420" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-110" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4DFF5BD8" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ui:TitleBar Grid.Row="0" Width="640" Height="32" Title="" ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="130" Height="130" CornerRadius="32" HorizontalAlignment="Center" Background="#1FFFFFFF">
                <Border.Effect>
                    <DropShadowEffect Color="#AA7C4DFF" BlurRadius="36" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
                <Image Source="{Binding Icon, Mode=OneWay}" Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="White" FontFamily="Orbitron SemiBold" Text="NEXUS STRAP" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="#B3FFFFFF" FontFamily="Segoe UI" Text="loading your experience..." />
        </StackPanel>

        <Border Grid.Row="2" Padding="26,18,26,22" Background="#CC191926" BorderBrush="#335555FF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#E6FFFFFF" FontFamily="Segoe UI" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Width="90" Height="34" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center" Content="{x:Static resources:Strings.Common_Cancel}" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding CancelEnabled}" BorderThickness="0" Background="#FF2A2A3D" Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
                <ProgressBar Grid.Row="1" Height="5" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Background="#33191926" BorderThickness="0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF7C4DFF" Offset="0" />
                            <GradientStop Color="#FF00D4FF" Offset="0.5" />
                            <GradientStop Color="#FFFF5BD8" Offset="1" />
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>