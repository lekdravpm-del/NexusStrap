<base:WpfUiWindow
    xmlns:base="clr-namespace:NexusStrap.UI.Elements.Base"
    x:Class="NexusStrap.UI.Elements.Bootstrapper.NeonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="580"
    Height="430"
    MinHeight="0"
    Background="#FF050508"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Disable"
    Closing="UiWindow_Closing"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <base:WpfUiWindow.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </base:WpfUiWindow.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Neon top line -->
        <Rectangle Grid.Row="0" Height="3" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF00E5FF" Offset="0" />
                    <GradientStop Color="#FFB300FF" Offset="0.5" />
                    <GradientStop Color="#FF00E5FF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Grid lines -->
        <Canvas Grid.Row="1" IsHitTestVisible="False" Opacity="0.12">
            <Line X1="0" Y1="0" X2="580" Y2="0" Stroke="#FF00E5FF" StrokeThickness="1" />
            <Line X1="0" Y1="100" X2="580" Y2="100" Stroke="#FF00E5FF" StrokeThickness="0.5" />
            <Line X1="0" Y1="200" X2="580" Y2="200" Stroke="#FF00E5FF" StrokeThickness="0.5" />
            <Line X1="0" Y1="0" X2="0" Y2="430" Stroke="#FF00E5FF" StrokeThickness="1" />
            <Line X1="580" Y1="0" X2="580" Y2="430" Stroke="#FF00E5FF" StrokeThickness="1" />
        </Canvas>

        <ui:TitleBar Grid.Row="0" Width="580" Height="32" Title="" ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="190" Height="190" HorizontalAlignment="Center" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6600E5FF" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border Width="128" Height="128" CornerRadius="64" HorizontalAlignment="Center" Margin="0,-190,0,0" Background="#0D0D12" BorderBrush="#FF00E5FF" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#FF00E5FF" BlurRadius="30" ShadowDepth="0" Opacity="0.95" />
                </Border.Effect>
                <Image Source="{Binding Icon, Mode=OneWay}" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White" FontFamily="Orbitron SemiBold" Text="NEXUS STRAP" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="#A6FFFFFF" FontFamily="Segoe UI" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,16,24,20" Background="#FF0C0C10" BorderBrush="#3300E5FF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="90" Height="34" Padding="0" Margin="0,0,16,0" VerticalAlignment="Center" Content="{x:Static resources:Strings.Common_Cancel}" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding CancelEnabled}" BorderThickness="1" BorderBrush="#4D00E5FF" Background="#FF12121A" Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium" Foreground="#E6FFFFFF" FontFamily="Segoe UI" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Background="#330C0C10" BorderThickness="0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF00E5FF" Offset="0" />
                            <GradientStop Color="#FFB300FF" Offset="0.6" />
                            <GradientStop Color="#FFFF00EA" Offset="1" />
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>