<base:WpfUiWindow
    x:Class="NexusStrap.UI.Elements.Bootstrapper.NexusStrapDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:NexusStrap.UI.Elements.Base"
    xmlns:wgif="http://wpfanimatedgif.codeplex.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:NexusStrap.UI.ViewModels.Bootstrapper"
    Width="520"
    Height="300"
    MinHeight="0"
    Background="#FF000000"
    Closing="UiWindow_Closing"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="{Binding Path=WindowBackdropType, Mode=OneTime}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#FF0D0D0D" Offset="0.5"/>
                    <GradientStop Color="#FF000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Ellipse Grid.RowSpan="3" Width="520" Height="220" VerticalAlignment="Top" Margin="0,-140,0,0" Fill="#18FFFFFF" IsHitTestVisible="False"/>
        <Ellipse Grid.RowSpan="3" Width="420" Height="180" VerticalAlignment="Bottom" Margin="0,0,0,-110" HorizontalAlignment="Right" Fill="#14FFFFFF" IsHitTestVisible="False"/>
        <Ellipse Grid.RowSpan="3" Width="300" Height="140" VerticalAlignment="Bottom" Margin="-120,0,0,-90" HorizontalAlignment="Left" Fill="#10FFFFFF" IsHitTestVisible="False"/>

        <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" CanMaximize="False" ShowClose="False" ShowMaximize="False" ShowMinimize="False"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                <Border Width="120" Height="120" CornerRadius="28" Background="#14FFFFFF" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon, Mode=OneWay}" Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White" FontFamily="Orbitron SemiBold" Text="NEXUS STRAP"/>
            </StackPanel>
            <Border Grid.Row="2" Padding="25,18,25,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#E6FFFFFF" FontFamily="Segoe UI" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Width="90" Height="34" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center" Content="{x:Static resources:Strings.Common_Cancel}" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding CancelEnabled}" BorderThickness="0" Background="#FF2A2A2A" Foreground="White">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="4" Margin="0,14,0,0" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Foreground="White" Background="#33232323"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</base:WpfUiWindow>
