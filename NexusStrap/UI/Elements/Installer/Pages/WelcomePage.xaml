<ui:UiPage x:Class="NexusStrap.UI.Elements.Installer.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:NexusStrap.UI.Elements.Installer.Pages"
      xmlns:models="clr-namespace:NexusStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:NexusStrap.UI.ViewModels.Installer"
      xmlns:resources="clr-namespace:NexusStrap.Resources"
      xmlns:controls="clr-namespace:NexusStrap.UI.Elements.Controls"
      xmlns:enums="clr-namespace:NexusStrap.Enums"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:WelcomeViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePage"
      Scrollable="True"
      Loaded="UiPage_Loaded"
      Background="Transparent">

    <Grid Margin="12,12,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NEXUS" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI">
            <TextBlock.Effect>
                <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Grid.Row="1" Text="by Recd" HorizontalAlignment="Center" FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

        <TextBlock Grid.Row="2" Text="{x:Static resources:Strings.Installer_Welcome_MainText}" HorizontalAlignment="Center"
                   FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="520"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" />

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Margin="0,0,6,0"
                       Height="48" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="32,0"
                       HorizontalAlignment="Stretch" Icon="ArrowRight24"
                       Content="Express Install" Click="ExpressInstall_Click" />
            <ui:Button Grid.Column="1" Margin="6,0,0,0"
                       Height="48" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="32,0"
                       HorizontalAlignment="Stretch" Icon="Settings24"
                       Content="Customize" Click="Customize_Click" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                       Text="github.com/lekdravpm-del/NexusStrap" />
        </StackPanel>
    </Grid>
</ui:UiPage>
