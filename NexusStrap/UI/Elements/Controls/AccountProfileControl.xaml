<UserControl x:Class="NexusStrap.UI.Elements.Controls.AccountProfileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
    Cursor="Hand">
    <Border CornerRadius="16" Padding="6,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="26" Height="26" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <ImageBrush x:Name="AvatarBrush" ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="DisplayNameText" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF" />
                        <Setter Property="BorderBrush" Value="#55FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>