<ui:UiPage x:Class="NexusStrap.UI.Elements.About.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:NexusStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:NexusStrap.UI.ViewModels.About"
      xmlns:controls="clr-namespace:NexusStrap.UI.Elements.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:NexusStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance dmodels:AboutViewModel, IsDesignTimeCreatable=True}"
      Title="AboutPage"
      KeyDown="UiPage_KeyDown"
      Scrollable="True">

    <ui:UiPage.Resources>
        <Storyboard x:Key="EggStoryboard">
            <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" />
            <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:3" />
        </Storyboard>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Logo + Title + Description -->
        <Border Grid.Row="0" Padding="20" Margin="0,0,0,16" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="80" Height="80" VerticalAlignment="Center">
                    <Image x:Name="Image1" Width="80" Height="80" VerticalAlignment="Center" Source="pack://application:,,,/Resources/Nexus.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image x:Name="Image2" Width="80" Height="80" VerticalAlignment="Center" Source="pack://application:,,,/Resources/BootstrapperStyles/ByfronDialog/Matt.png" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
                </Grid>

<StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NEXUS STRAP" FontSize="28" FontWeight="Bold" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Gamer1 is a femboy~" FontSize="9" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{x:Static resources:Strings.Menu_About_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Links Row -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
            <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="BookExclamationMark24" Content="Report Issue" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lekdravpm-del/NexusStrap/issues" />
            <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="Chat24" Content="Discord" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://discord.gg/hvhEDxFek" />
            <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="Library24" Content="Wiki" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lekdravpm-del/NexusStrap/wiki" />
        </WrapPanel>

        <!-- Credits Section -->
        <Border Grid.Row="2" Padding="16" Margin="0,0,0,16" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Credits" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Code -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Code" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <Border Padding="10" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Recd" FontSize="14" FontWeight="Medium" />
                                <Button Content="Roblox Profile" Margin="0,6,0,0" Padding="8,4" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://www.roblox.com/users/3573547911/profile" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Contributors -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Contributors" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <Border Padding="10" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="tailoop" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Burger" FontSize="14" FontWeight="Medium" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Build Information -->
        <StackPanel Grid.Row="3" Visibility="{Binding BuildInformationVisibility, Mode=OneTime}" Margin="0,0,0,16">
            <Border Padding="16" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Build Information" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="Timestamp" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Text="{Binding BuildTimestamp, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="Version" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Text="{Binding Version, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="Commit Hash" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
                            <Hyperlink Foreground="{DynamicResource TextFillColorTertiaryBrush}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding BuildCommitHashUrl, Mode=OneTime}">
                                <TextBlock Text="{Binding BuildMetadata.CommitHash, Mode=OneTime}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="Commit Ref" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Text="{Binding BuildMetadata.CommitRef, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="Made by Recd" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
    </Grid>
</ui:UiPage>
