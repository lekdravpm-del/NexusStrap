<ui:UiPage x:Class="NexusStrap.UI.Elements.AccountManagers.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:NexusStrap.UI.ViewModels"
      xmlns:dmodels="clr-namespace:NexusStrap.UI.ViewModels.AccountManagers"
      xmlns:controls="clr-namespace:NexusStrap.UI.Elements.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:NexusStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="850"
      Title="Accounts Page"
      Scrollable="True">

    <Grid Margin="4,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Current Account - Accent Card -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,16"
            Padding="20,16"
            CornerRadius="10"
            Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.4"/>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Left="3" Top="0" Right="0" Bottom="0"/>
            </Border.BorderThickness>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="ACTIVE SESSION" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid>
                            <Border
                                Width="60"
                                Height="60"
                                CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentUserAvatarUrl}" Stretch="UniformToFill" />
                                </Border.Background>
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,60,60"/>
                                </Border.Clip>
                            </Border>

                            <Border
                                Width="14"
                                Height="14"
                                Margin="0,0,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{Binding CurrentUserPresence.StatusColor, FallbackValue=#808080}"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="2"
                                CornerRadius="7"
                                ToolTip="{Binding CurrentUserPresence.ToolTipText, FallbackValue='Offline'}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" Opacity="0.6" ShadowDepth="0" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding CurrentUserDisplayName}" />
                            <TextBlock
                                FontSize="13"
                                Margin="0,2,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding CurrentUserUsername}" />

                            <StackPanel
                                Margin="0,6,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsAccountInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding FriendsCount, StringFormat='{}{0} Friends'}" />
                                </Border>
                                <Border Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding FollowersCount, StringFormat='{}{0} Followers'}" />
                                </Border>
                                <Border Padding="6,2" CornerRadius="4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding FollowingCount, StringFormat='{}{0} Following'}" />
                                </Border>
                            </StackPanel>
                            <!-- ID row with copy -->
                            <Border Margin="0,8,0,0" Padding="8,4" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding IsAccountLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentUserIdText}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="2" Width="26" Height="26" Padding="0" Appearance="Secondary" Command="{Binding CopyIdCommand}" ToolTip="Copy ID" Margin="8,0,0,0">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13"/>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Danger"
                        Command="{Binding SignOutCommand}"
                        Content="Sign Out" />
                </Grid>
            </Grid>
        </Border>

        <!-- Manage Accounts -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{DynamicResource PrimaryBackgroundColor}"
            BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Saved Accounts" />

                <ListBox
                    x:Name="AccountsListBox"
                    Grid.Row="1"
                    MaxHeight="400"
                    AllowDrop="True"
                    BorderThickness="0"
                    ItemsSource="{Binding Accounts}"
                    SelectedItem="{Binding SelectedAccount}"
                    SelectionMode="Single">

                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SelectAccountCommand}" />
                    </ListBox.InputBindings>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="8"
                                        Margin="0,0,12,0">
                                    <Border.Background>
                                        <ImageBrush
                                            ImageSource="{Binding AvatarUrl}"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Username}" />
                                </StackPanel>

                                <ui:Button
                                    Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Appearance="Danger"
                                    Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Remove this account">
                                    <ui:SymbolIcon FontSize="13" Symbol="Delete24" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Height="36"
                            Appearance="Primary"
                            Command="{Binding SelectAccountCommand}"
                            Content="Switch to Selected" />

                        <ui:Button
                            x:Name="AddNewAccountButton"
                            Grid.Column="1"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddAccountCommand}"
                            Content="Add New Account" />

                        <ComboBox
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Width="140"
                            ItemsSource="{Binding AddMethods}"
                            SelectedItem="{Binding SelectedAddMethod}" />
                    </Grid>

                    <TextBlock
                            Grid.Row="0"
                            Margin="0,8,0,6"
                            FontSize="13"
                            Text="Installing Chromium browser for account manager, this will take a long time to finish, please wait"
                            Visibility="{Binding IsInstallingChromium, Converter={StaticResource BooleanToVisibilityConverter}}"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:UiPage>
