<base:WpfUiWindow x:Class="NexusStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:NexusStrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:base="clr-namespace:NexusStrap.UI.Elements.Base"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    xmlns:controls="clr-namespace:NexusStrap.UI.Elements.Controls"
    xmlns:dmodels="clr-namespace:NexusStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="250"
             Width="1125"
             MinHeight="250"
             Height="700"
             Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed">

    <Grid Background="{DynamicResource ApplicationBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Background="{DynamicResource NormalDarkAndLightBackground}" Icon="Info20" Timeout="5000" Margin="200,0,200,40" Grid.RowSpan="10" Panel.ZIndex="10" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Background="#CC1A1A1A" Icon="CheckmarkCircle24" Timeout="3000" Margin="200,0,200,40" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/NX.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="10,8,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NEXUS STRAP" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:TextBox x:Name="SearchBox" Width="160" PlaceholderText="Search..." Margin="0,0,24,0" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <controls:AccountProfileControl VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ui:Anchor Content="Roblox" Icon="Games24" NavigateUri="https://www.roblox.com/users/3573547911/profile" ToolTip="Follow my Roblox profile" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <ui:Anchor Content="Discord" Icon="Chat24" NavigateUri="https://discord.gg/hvhEDxFek" ToolTip="Join our Discord server" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <ui:NavigationCompact x:Name="RootNavigation" Grid.Row="1" Grid.Column="0" Margin="4,0,16,0" Frame="{Binding ElementName=RootFrame}" IsExpanded="{Binding IsSidebarExpanded, Mode=TwoWay}" MaxWidth="195" SelectedPageIndex="0" FooterAlwaysVisible="True" Background="Transparent">
                <ui:NavigationCompact.Items>
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" PageType="{x:Type pages:IntegrationsPage}" Icon="PuzzlePiece24" IconSize="20" Tag="integrations" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Behaviour_Title}" PageType="{x:Type pages:BehaviourPage}" Icon="Rocket24" IconSize="20" Tag="bootstrapper" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Title}" PageType="{x:Type pages:FastFlagsPage}" Icon="Tag24" IconSize="20" Tag="fastflags" />
                    <ui:NavigationItem Content="FFlag Templates" PageType="{x:Type pages:FFlagTemplatesPage}" Icon="Library24" IconSize="20" Tag="fflagtemplates" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="Color24" IconSize="20" Tag="appearance" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_RegionSelector_Title}" PageType="{x:Type pages:RegionSelectorPage}" Icon="Navigation24" IconSize="20" Tag="regionselector" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_RobloxSettings_Title}" PageType="{x:Type pages:RobloxSettingsPage}" Icon="LauncherSettings24" IconSize="20" Tag="robloxsettings" x:Name="gbs" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Common_Shortcuts}" PageType="{x:Type pages:ShortcutsPage}" Icon="Keyboard24" IconSize="20" Tag="shortcuts" />

                    <ui:NavigationItem Content="Server History" PageType="{x:Type pages:ServerHistoryPage}" Icon="History24" IconSize="20" Tag="serverhistory" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.ServerBrowser_Title}" PageType="{x:Type pages:ServerBrowserPage}" Icon="Globe24" IconSize="20" Tag="serverbrowser" x:Name="serverBrowser" />
                    <ui:NavigationItem Content="Launch Arguments" PageType="{x:Type pages:CustomLaunchArgsPage}" Icon="Code24" IconSize="20" Tag="launchargs" />
                    <ui:NavigationItem Content="Log Viewer" PageType="{x:Type pages:LogViewerPage}" Icon="Document24" IconSize="20" Tag="logviewer" />
                    <ui:NavigationItem Content="App Analyzer" PageType="{x:Type pages:AppAnalyzerPage}" Icon="ScanText24" IconSize="20" Tag="appanalyzer" />
                    <ui:NavigationItem Content="Analytics" PageType="{x:Type pages:AnalyticsPage}" Icon="ChartPerson24" IconSize="20" Tag="analytics" />

                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" PageType="{x:Type pages:FastFlagEditorPage}" Icon="EditSettings20" IconSize="20" Tag="fastflageditor" Visibility="Collapsed" />
                    <ui:NavigationItem Content="FastFlagEditorWarning" PageType="{x:Type pages:FastFlagEditorWarningPage}" Icon="Warning24" IconSize="20" Tag="fastflageditorwarning" Visibility="Collapsed" />
                    <ui:NavigationItem Content="Optimization Setup" PageType="{x:Type pages:OptimizationSetupPage}" Icon="HeartPulse24" IconSize="20" Tag="optimizationsetup" Visibility="Collapsed" />
                    <ui:NavigationItem Content="Secret" PageType="{x:Type pages:SecretPage}" Icon="Sparkle24" IconSize="20" Tag="secret" Visibility="Collapsed" />
                    <ui:NavigationItem Content="Community Mods" PageType="{x:Type pages:CommunityModsPage}" Icon="BuildingShop24" IconSize="20" Tag="communitymods" Visibility="Collapsed" />
                    <ui:NavigationItem Content="Mods" PageType="{x:Type pages:ModsPresetsPage}" Icon="BuildingShop24" IconSize="20" Tag="mods" />
                    <ui:NavigationItem Content="Mod Generator" PageType="{x:Type pages:ModGeneratorPage}" Icon="BuildingShop24" IconSize="20" Tag="modgenerator" Visibility="Collapsed" />
                    <ui:NavigationItem Content="Theme Store" PageType="{x:Type pages:ThemeStorePage}" Icon="PaintBrush24" IconSize="20" Tag="themestore" Visibility="Collapsed" />
                </ui:NavigationCompact.Items>
                <ui:NavigationCompact.Footer>
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_AccountManager_Title}" Icon="ContactCard24" IconSize="20" Tag="accountmanager"  Command="{Binding OpenAccountManagerCommand, Mode=OneTime}" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Common_Settings}" PageType="{x:Type pages:ChannelPage}" Icon="Options24" IconSize="20" Tag="channel" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="Info24" IconSize="21" Margin="0,0,0,12" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
                </ui:NavigationCompact.Footer>
            </ui:NavigationCompact>

            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:InfoBar x:Name="AlertBar" Grid.Row="0" Margin="0,0,12,0" Padding="8" Visibility="Collapsed" IsOpen="True" Message="" Severity="Warning" IsClosable="False" />
                <ui:Breadcrumb Grid.Row="1" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" />
                <Frame x:Name="RootFrame" Grid.Row="2" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar"
           Grid.Row="2"
           Padding="12,6"
           BorderThickness="0,1,0,0">

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Test Mode -->
            <StatusBarItem Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_TestMode}"
                       FontSize="13.5"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StatusBarItem>

            <!-- Made by -->
            <StatusBarItem Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock Text="" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StatusBarItem>

            <!-- Close -->
            <StatusBarItem Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}"
                   Height="32"
                   Padding="14,0"
                   FontWeight="Medium"
                   Command="{Binding CloseWindowCommand}" />
            </StatusBarItem>

            <!-- Save -->
            <StatusBarItem Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}"
                   Appearance="Primary"
                   Height="32"
                   Padding="14,0"
                   FontWeight="Medium"
                   Command="{Binding SaveSettingsCommand}" />
            </StatusBarItem>

            <!-- Restart -->
            <StatusBarItem Grid.Column="5" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Restart}"
               Height="32"
               Padding="14,0"
               FontWeight="Medium"
               Appearance="Primary"
               Command="{Binding RestartAppCommand}" />
            </StatusBarItem>

            <!-- Save & Launch -->
            <StatusBarItem Grid.Column="6" VerticalAlignment="Center" Margin="0,0,0,0">
                <ui:Button x:Name="LaunchButton"
               Content="{x:Static resources:Strings.Menu_SaveAndLaunch}"
               Appearance="Primary"
               Height="32"
               FontWeight="Bold"
               Padding="18,0"
               Click="LaunchButton_Click">
                    <ui:Button.ContextMenu>
                        <ContextMenu x:Name="LaunchMenu">
                            <MenuItem Header="Launch Roblox Player" Command="{Binding SaveAndLaunchPlayerCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Games24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Launch Roblox Studio" Command="{Binding SaveAndLaunchStudioCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="TextBulletListSquareToolbox20" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="LoadingOverlay"
            Visibility="Collapsed"
            Background="#A0000000"
            Panel.ZIndex="9999"
            Grid.Row="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource NormalDarkAndLightBackground}"
                    CornerRadius="16"
                    Padding="32"
                    Effect="{DynamicResource ControlShadow}">
                    <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">

                        <!-- Loading Text -->
                        <TextBlock x:Name="LoadingOverlayText"
                           Text="Loading..."
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:ProgressRing
                            IsIndeterminate="True"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0" />

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <controls:SpotlightGuide x:Name="GuideOverlay" Grid.RowSpan="3" Visibility="Collapsed" />
    </Grid>
</base:WpfUiWindow>