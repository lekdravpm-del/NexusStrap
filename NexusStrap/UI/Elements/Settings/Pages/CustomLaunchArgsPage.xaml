<ui:UiPage x:Class="NexusStrap.UI.Elements.Settings.Pages.CustomLaunchArgsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    Title="Custom Launch Arguments"
    Scrollable="True"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="800">
    <StackPanel Margin="0,8,14,14">
        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Add custom command-line arguments that will be passed to the Roblox executable on launch." Margin="0,0,0,4" />
        <TextBlock FontSize="20" FontWeight="Bold" Text="Custom Launch Arguments" Margin="0,0,0,12" />

        <Border Padding="16" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Add New Argument" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding NewArgName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g., No Splash" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Argument:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding NewArgValue, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g., --no-splash" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding NewArgDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What does this flag do?" />
                </Grid>
                <ui:Button Content="Add Argument" Appearance="Primary" Command="{Binding AddArgCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="Saved Arguments" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Remove Selected" Appearance="Danger" Command="{Binding RemoveArgCommand}" IsEnabled="{Binding CanRemove}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding LaunchArgs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" Margin="0,0,0,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:ToggleSwitch Grid.Column="0" IsChecked="{Binding Enabled}" MinWidth="70" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Argument}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Description}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
