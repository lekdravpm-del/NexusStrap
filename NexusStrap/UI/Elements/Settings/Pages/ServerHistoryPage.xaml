<ui:UiPage x:Class="NexusStrap.UI.Elements.Settings.Pages.ServerHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    Title="Server Rejoin History"
    Scrollable="True"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="0,8,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="Server Rejoin History" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Rejoin Selected" Appearance="Primary" Command="{Binding RejoinCommand}" IsEnabled="{Binding CanRejoin}" Margin="0,0,8,0" />
            <ui:Button Content="Clear History" Appearance="Danger" Command="{Binding ClearHistoryCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedEntry}"
            ItemsSource="{Binding HistoryEntries}"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            BorderThickness="0"
            RowBackground="Transparent"
            AlternatingRowBackground="Transparent"
            CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="200" />
                <DataGridTextColumn Header="Server Type" Binding="{Binding ServerTypeDisplay}" Width="90" />
                <DataGridTextColumn Header="Joined" Binding="{Binding TimeJoinedDisplay}" Width="140" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" />
                <DataGridTextColumn Header="Place ID" Binding="{Binding PlaceId}" Width="100" />
                <DataGridTextColumn Header="Server ID" Binding="{Binding JobId}" Width="260" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:UiPage>
