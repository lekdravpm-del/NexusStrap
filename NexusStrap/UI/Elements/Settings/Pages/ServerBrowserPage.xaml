<ui:UiPage x:Class="NexusStrap.UI.Elements.Settings.Pages.ServerBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:NexusStrap.Resources"
    xmlns:controls="clr-namespace:NexusStrap.UI.Elements.Controls"
    Title="{x:Static resources:Strings.ServerBrowser_Title}"
    Scrollable="True"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="0,8,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="{x:Static resources:Strings.ServerBrowser_Title}" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox MinWidth="180" Margin="0,0,8,0" VerticalAlignment="Center"
                ItemsSource="{Binding Games}"
                SelectedItem="{Binding SelectedGame}"
                DisplayMemberPath="Name" />
            <ui:TextBox Width="120" Margin="0,0,8,0" VerticalAlignment="Center"
                PlaceholderText="{x:Static resources:Strings.ServerBrowser_PlaceId}"
                Text="{Binding CustomPlaceId, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center"
                ItemsSource="{Binding PlayerCountFilters}"
                SelectedValue="{Binding SelectedPlayerCountFilter}"
                DisplayMemberPath="Display" SelectedValuePath="Key" />
            <ComboBox MinWidth="150" Margin="0,0,8,0" VerticalAlignment="Center"
                ItemsSource="{Binding RegionFilters}"
                SelectedValue="{Binding SelectedRegionFilter}"
                DisplayMemberPath="Display" SelectedValuePath="Key" />
            <ComboBox MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center"
                ItemsSource="{Binding UptimeFilters}"
                SelectedValue="{Binding SelectedUptimeFilter}"
                DisplayMemberPath="Display" SelectedValuePath="Key" />
            <ui:Button Content="{x:Static resources:Strings.ServerBrowser_Refresh}" Appearance="Primary" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{x:Static resources:Strings.ServerBrowser_LoadMore}" Command="{Binding LoadMoreCommand}" Margin="0,0,8,0" />
            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" VerticalAlignment="Center">
                <ui:ProgressRing.Style>
                    <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:ProgressRing.Style>
            </ui:ProgressRing>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,0,0,4" Foreground="Gray" FontSize="12" Text="{Binding StatusText}" />
        <TextBlock Grid.Row="2" Margin="0,0,0,4" Foreground="Gray" FontSize="12" Text="{x:Static resources:Strings.ServerBrowser_RegionHint}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RegionDetectionEnabled}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="3"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            ItemsSource="{Binding Servers}"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            BorderThickness="0"
            RowBackground="Transparent"
            AlternatingRowBackground="Transparent"
            CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.ServerBrowser_Players}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayersDisplay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <controls:ServerCapacityIndicator Width="56" Height="14" VerticalAlignment="Center"
                                    Capacity="{Binding Capacity}"
                                    ToolTip="{Binding PlayersDisplay}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static resources:Strings.ServerBrowser_Region}" Binding="{Binding Region}" Width="170" />
                <DataGridTextColumn Header="{x:Static resources:Strings.ServerBrowser_Uptime}" Binding="{Binding UptimeDisplay}" Width="110" />
                <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="60" />
                <DataGridTextColumn Header="FPS" Binding="{Binding Fps}" Width="60" />
                <DataGridTextColumn Header="{x:Static resources:Strings.ServerBrowser_ServerId}" Binding="{Binding Id}" Width="240" />
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="{x:Static resources:Strings.ServerBrowser_Join}" Padding="10,3" Height="26"
                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:UiPage>