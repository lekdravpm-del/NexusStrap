<ui:UiPage x:Class="NexusStrap.UI.Elements.Settings.Pages.HealthCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Health Check"
    Scrollable="True"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="800">
    <StackPanel Margin="0,8,14,14">
        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Diagnoses common issues that may prevent Roblox from launching or cause errors." Margin="0,0,0,4" />
        <TextBlock FontSize="20" FontWeight="Bold" Text="Health Check" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Run Health Check" Appearance="Primary" Command="{Binding RunCheckCommand}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
        </Grid>

        <Border Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
            <ScrollViewer MaxHeight="400">
                <TextBlock
                    Text="{Binding CheckResults}"
                    FontFamily="Consolas"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Border>
    </StackPanel>
</ui:UiPage>
